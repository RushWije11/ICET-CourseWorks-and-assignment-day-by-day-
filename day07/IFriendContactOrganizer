import java.util.*;
class IFriendContactOrganizer {

    public static String[] contactIds = new String[0];
    public static String[] names = new String[0];
    public static String[] phoneNos = new String[0];
    public static String[] companyNames = new String[0];
    public static double[] salaries = new double[0];
    public static String[] birthdays = new String[0];

    public final static void clearConsole() {
        System.out.print("\033[H\033[2J");
        System.out.flush();
    }

    public static String generateContactId(int contactNum) {
        if (contactNum < 10) {
            return "C000" + contactNum;
        } else if (contactNum < 100) {
            return "C00" + contactNum;
        } else if (contactNum < 1000) {
            return "C0" + contactNum;
        } else {
            return "C" + contactNum;
        }
    }

    public static boolean checkPhoneNo(String phoneNo) {
        if (phoneNo.length() != 10) {
            return false;
        }
        if (phoneNo.charAt(0) != '0') {
            return false;
        }

        for (int i = 0; i < phoneNo.length(); i++) {
            char ch = phoneNo.charAt(i);
            if (ch < '0' || ch > '9') {
                return false;
            }
        }
        return true;
    }

    public static boolean checkSalary(double salary) {
        if (salary >= 0) {
            return true;
        }
        return false;
    }

    public static boolean checkBirthday(String bday) {
        if (bday.length() != 10) {
            return false;
        }
        if (bday.charAt(4) != '-') {
            return false;
        }
        if (bday.charAt(7) != '-') {
            return false;
        }

        for (int i = 0; i < bday.length(); i++) {
            if (i == 4 || i == 7) {
                continue;
            }
            char ch = bday.charAt(i);
            if (ch < '0' || ch > '9') {
                return false;
            }
        }

        return true;
    }

    public static void extendArrays() {
        String[] newContactIds = new String[contactIds.length + 1];
        String[] newNames = new String[names.length + 1];
        String[] newPhoneNos = new String[phoneNos.length + 1];
        String[] newCompanyNames = new String[companyNames.length + 1];
        double[] newSalaries = new double[salaries.length + 1];
        String[] newBirthdays = new String[birthdays.length + 1];

        for (int i = 0; i < contactIds.length; i++) {
            newContactIds[i] = contactIds[i];
            newNames[i] = names[i];
            newPhoneNos[i] = phoneNos[i];
            newCompanyNames[i] = companyNames[i];
            newSalaries[i] = salaries[i];
            newBirthdays[i] = birthdays[i];
        }

        contactIds = newContactIds;
        names = newNames;
        phoneNos = newPhoneNos;
        companyNames = newCompanyNames;
        salaries = newSalaries;
        birthdays = newBirthdays;
    }

    public static int searchContactIndex(String searchKey) {
        for (int i = 0; i < contactIds.length; i++) {
            if (names[i].equalsIgnoreCase(searchKey) || phoneNos[i].equals(searchKey)) {
                return i;
            }
        }
        return -1;
    }

    public static void printContactDetails(int index) {
        System.out.println("\tContact ID       : " + contactIds[index]);
        System.out.println("\tName             : " + names[index]);
        System.out.println("\tPhone Number     : " + phoneNos[index]);
        System.out.println("\tCompany Name     : " + companyNames[index]);
        System.out.println("\tSalary           : " + salaries[index]);
        System.out.println("\tB'Day(YYYY-MM-DD): " + birthdays[index]);
    }

    public static int compareStrings(String s1, String s2) {
        int minLength = s1.length() < s2.length() ? s1.length() : s2.length();

        for (int i = 0; i < minLength; i++) {
            if (s1.charAt(i) != s2.charAt(i)) {
                return s1.charAt(i) - s2.charAt(i);
            }
        }
        return s1.length() - s2.length();
    }

    public static void addContacts() {
        Scanner input = new Scanner(System.in);
        char addRetry = 'Y';

        do {
            clearConsole();
            System.out.println("+-----------------------------------------------+");
            System.out.println("|\t   Add Contact to the list  \t\t|");
            System.out.println("+-----------------------------------------------+");
            System.out.println();

            String id = generateContactId(contactIds.length + 1);
            System.out.println(id);
            System.out.println("=======\n");

            System.out.print("Name : ");
            String name = input.nextLine();

            String phoneNo = "";
            while (true) {
                System.out.print("Phone Number : ");
                phoneNo = input.nextLine();
                if (checkPhoneNo(phoneNo)) {
                    break;
                }
                System.out.println("\n\tInvalid phone number...\n");
                System.out.print("Do you want to add phone number again (Y/N): ");
                String optStr = input.nextLine();
                char opt = optStr.length() > 0 ? optStr.charAt(0) : 'N';
                if (opt == 'Y' || opt == 'y') {
                    System.out.print("\033[5A");
                    System.out.print("\033[0J");
                } else {
                    return;
                }
            }

            System.out.print("Company Name : ");
            String company = input.nextLine();

            double salary = 0;
            while (true) {
                System.out.print("Salary : ");
                try {
                    salary = Double.parseDouble(input.nextLine());
                    if (checkSalary(salary)) {
                        break;
                    }
                } catch (NumberFormatException e) {
                    // Invalid double input
                }
                System.out.println("\n\tInvalid Salary...\n");
                System.out.print("Do you want to input salary again (Y/N): ");
                String optStr = input.nextLine();
                char opt = optStr.length() > 0 ? optStr.charAt(0) : 'N';
                if (opt == 'Y' || opt == 'y') {
                    System.out.print("\033[5A");
                    System.out.print("\033[0J");
                } else {
                    return;
                }
            }

            String bday = "";
            while (true) {
                System.out.print("B'Day(YYYY-MM-DD): ");
                bday = input.nextLine();
                if (checkBirthday(bday)) {
                    break;
                }
                System.out.println("\n\tInvalid Birthday...\n");
                System.out.print("Do you want to input birthday again (Y/N): ");
                String optStr = input.nextLine();
                char opt = optStr.length() > 0 ? optStr.charAt(0) : 'N';
                if (opt == 'Y' || opt == 'y') {
                    System.out.print("\033[5A");
                    System.out.print("\033[0J");
                } else {
                    return;
                }
            }

            extendArrays();
            int idx = contactIds.length - 1;
            contactIds[idx] = id;
            names[idx] = name;
            phoneNos[idx] = phoneNo;
            companyNames[idx] = company;
            salaries[idx] = salary;
            birthdays[idx] = bday;

            System.out.println("\n\tContact has been added successfully...\n");

            System.out.print("Do you want to add another Contact(Y/N): ");
            String retryStr = input.nextLine();
            addRetry = retryStr.length() > 0 ? retryStr.charAt(0) : 'N';

        } while (addRetry == 'Y' || addRetry == 'y');
    }

    public static void updateContacts() {
        Scanner input = new Scanner(System.in);
        char retry = 'Y';

        do {
            clearConsole();
            System.out.println("+-----------------------------------------------+");
            System.out.println("|\t\tUPDATE Contact\t\t\t|");
