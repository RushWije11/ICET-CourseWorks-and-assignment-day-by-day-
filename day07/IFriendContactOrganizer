    public static void printSortedTable(String title, int sortType) {
        clearConsole();
        System.out.println("+---------------------------------------------------------------------------------------+");
        System.out.println("|\t\t\t\t" + title + "\t\t\t\t\t|");
        System.out.println("+---------------------------------------------------------------------------------------+");

        int n = contactIds.length;
        String[] cIds = new String[n];
        String[] cNames = new String[n];
        String[] cPhones = new String[n];
        String[] cComps = new String[n];
        double[] cSals = new double[n];
        String[] cBdays = new String[n];

        for (int i = 0; i < n; i++) {
            cIds[i] = contactIds[i];
            cNames[i] = names[i];
            cPhones[i] = phoneNos[i];
            cComps[i] = companyNames[i];
            cSals[i] = salaries[i];
            cBdays[i] = birthdays[i];
        }

        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                boolean condition = false;

                if (sortType == 1) {
                    condition = compareStrings(cNames[j], cNames[j + 1]) > 0;
                } else if (sortType == 2) {
                    condition = cSals[j] > cSals[j + 1];
                } else if (sortType == 3) {
                    condition = compareStrings(cBdays[j], cBdays[j + 1]) > 0;
                }

                if (condition) {
                    String tempId = cIds[j];
                    cIds[j] = cIds[j + 1];
                    cIds[j + 1] = tempId;

                    String tempName = cNames[j];
                    cNames[j] = cNames[j + 1];
                    cNames[j + 1] = tempName;

                    String tempPhone = cPhones[j];
                    cPhones[j] = cPhones[j + 1];
                    cPhones[j + 1] = tempPhone;

                    String tempComp = cComps[j];
                    cComps[j] = cComps[j + 1];
                    cComps[j + 1] = tempComp;

                    double tempSal = cSals[j];
                    cSals[j] = cSals[j + 1];
                    cSals[j + 1] = tempSal;

                    String tempBday = cBdays[j];
                    cBdays[j] = cBdays[j + 1];
                    cBdays[j + 1] = tempBday;
                }
            }
        }

        System.out.println("+------------+--------------------+--------------+--------------------+------------+------------+");
        System.out.printf("| %-10s | %-18s | %-12s | %-18s | %-10s | %-10s |\n", "Contact ID", "Name", "Phone Number", "Company", "Salary", "Birthday");
        System.out.println("+------------+--------------------+--------------+--------------------+------------+------------+");

        for (int i = 0; i < n; i++) {
            System.out.printf("| %-10s | %-18s | %-12s | %-18s | %-10.2f | %-10s |\n", cIds[i], cNames[i], cPhones[i], cComps[i], cSals[i], cBdays[i]);
        }
        System.out.println("+------------+--------------------+--------------+--------------------+------------+------------+");
    }

