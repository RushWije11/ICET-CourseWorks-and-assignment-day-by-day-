            String searchKey = input.nextLine();

            int index = searchContactIndex(searchKey);
            if (index == -1) {
                System.out.println("\n\tNo contact found for " + searchKey + "...\n");
            } else {
                System.out.println();
                printContactDetails(index);
                System.out.println("\nWhat do you want to update...\n");
                System.out.println("\t[01] Name");
                System.out.println("\t[02] Phone Number");
                System.out.println("\t[03] Company Name");
                System.out.println("\t[04] Salary\n");

                System.out.print("Enter an option to continue -> ");
                String opt = input.nextLine();

                switch (opt) {
                    case "1":
                    case "01":
                        System.out.println("\nUpdate Name\n===========");
                        System.out.print("Input new name - ");
                        names[index] = input.nextLine();
                        System.out.println("\n\tContact has been updated successfully...");
                        break;
                    case "2":
                    case "02":
                        System.out.println("\nUpdate Phone Number\n===================");
                        while (true) {
                            System.out.print("Input new phone number - ");
                            String pNo = input.nextLine();
                            if (checkPhoneNo(pNo)) {
                                phoneNos[index] = pNo;
                                System.out.println("\n\tContact has been updated successfully...");
                                break;
                            } else {
                                System.out.println("\tInvalid phone number...");
                            }
                        }
                        break;
                    case "3":
                    case "03":
                        System.out.println("\nUpdate Company Name\n===================");
                        System.out.print("Input new company name - ");
                        companyNames[index] = input.nextLine();
                        System.out.println("\n\tContact has been updated successfully...");
                        break;
                    case "4":
                    case "04":
                        System.out.println("\nUpdate Salary\n=============");
                        while (true) {
                            System.out.print("Input new salary - ");
                            try {
                                double sal = Double.parseDouble(input.nextLine());
                                if (checkSalary(sal)) {
                                    salaries[index] = sal;
                                    System.out.println("\n\tContact has been updated successfully...");
                                    break;
                                } else {
                                    System.out.println("\tInvalid salary...");
                                }
                            } catch (NumberFormatException e) {
                                System.out.println("\tInvalid salary format...");
                            }
                        }
                        break;
                    default:
                        System.out.println("\n\tInvalid Option selected...");
                        break;
                }
            }

            System.out.print("\nDo you want to update another Contact (Y/N): ");
            String retryStr = input.nextLine();
            retry = retryStr.length() > 0 ? retryStr.charAt(0) : 'N';

        } while (retry == 'Y' || retry == 'y');
    }

    public static void deleteContacts() {
        Scanner input = new Scanner(System.in);
        char retry = 'Y';

        do {
            clearConsole();
            System.out.println("+-----------------------------------------------+");
            System.out.println("|\t\tDELETE Contact\t\t\t|");
            System.out.println("+-----------------------------------------------+");
            System.out.println();

            System.out.print("Search Contact by Name or Phone Number - ");
            String searchKey = input.nextLine();

            int index = searchContactIndex(searchKey);
            if (index == -1) {
                System.out.println("\n\tNo contact found for " + searchKey + "...\n");
            } else {
                System.out.println();
                printContactDetails(index);

                System.out.print("\nDo you want to delete this Contact (Y/N): ");
                String confirmStr = input.nextLine();
                char confirm = confirmStr.length() > 0 ? confirmStr.charAt(0) : 'N';

                if (confirm == 'Y' || confirm == 'y') {
                    String[] newContactIds = new String[contactIds.length - 1];
                    String[] newNames = new String[names.length - 1];
                    String[] newPhoneNos = new String[phoneNos.length - 1];
                    String[] newCompanyNames = new String[companyNames.length - 1];
                    double[] newSalaries = new double[salaries.length - 1];
                    String[] newBirthdays = new String[birthdays.length - 1];

                    for (int i = 0, k = 0; i < contactIds.length; i++) {
                        if (i == index) continue;
                        newContactIds[k] = contactIds[i];
                        newNames[k] = names[i];
                        newPhoneNos[k] = phoneNos[i];
                        newCompanyNames[k] = companyNames[i];
                        newSalaries[k] = salaries[i];
                        newBirthdays[k] = birthdays[i];
                        k++;
                    }

                    contactIds = newContactIds;
                    names = newNames;
                    phoneNos = newPhoneNos;
                    companyNames = newCompanyNames;
                    salaries = newSalaries;
                    birthdays = newBirthdays;

                    System.out.println("\n\tCustomer has been deleted successfully...\n");
                }
            }

            System.out.print("Do you want to delete another Contact (Y/N): ");
            String retryStr = input.nextLine();
            retry = retryStr.length() > 0 ? retryStr.charAt(0) : 'N';

        } while (retry == 'Y' || retry == 'y');
    }

